# 이 파일을 복사해서 .env 로 이름을 바꾸고 실제 값을 넣으세요.
#   Windows PowerShell : Copy-Item batch\.env.example batch\.env
#   Git Bash           : cp batch/.env.example batch/.env
#
# .env 는 .gitignore 가 막고 있어서 git 에 올라가지 않습니다.
# GitHub Actions 로 돌릴 때는 저장소 Settings > Secrets 에 같은 이름으로 넣습니다.

# 서울시 실시간 도시데이터 API
# 확인 필요: 응답 형식과 호출 제한은 키 발급 후 확인
SEOUL_API_KEY=

# Supabase — batch 는 권한 규칙을 넘어 표에 직접 써야 해서 service key 를 씁니다
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
