# 이 파일을 복사해서 local.properties 로 이름을 바꾸고 실제 값을 넣으세요.
#   Windows PowerShell : Copy-Item android\local.properties.example android\local.properties
#   Git Bash           : cp android/local.properties.example android/local.properties
#
# local.properties 는 .gitignore 가 막고 있어서 git 에 올라가지 않습니다.
# 저장소가 공개라 키가 올라가면 바로 노출됩니다. 절대 이 파일(.example)에 진짜 키를 적지 마세요.

# Android SDK 경로 — Android Studio 가 프로젝트를 열 때 보통 자동으로 채웁니다
sdk.dir=C\:\Users\사용자이름\AppData\Local\Android\Sdk

# 지도 SDK 키 — 카카오 / 네이버 중 무엇을 쓸지 아직 미정 (CLAUDE.md "아직 확인 안 된 것")
MAP_API_KEY=

# Supabase — 앱은 anon key 만 씁니다
SUPABASE_URL=
SUPABASE_ANON_KEY=

# service key 는 앱에 넣지 않습니다 (CLAUDE.md 원칙 7)
